<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>13</LangVersion>
		<Nullable>enable</Nullable>
		<DefineConstants>TRANSLATOR</DefineConstants>
		<!-- <PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap> -->
		<Deterministic>true</Deterministic>
		<DeterministicSourcePaths>false</DeterministicSourcePaths>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<!-- 1. 项目本地库 -->
		<!-- 0Harmony20.dll 由下方带 Aliases=HarmonyLegacy 的引用单独引入，避免与 0Harmony.dll 的 HarmonyLib 类型冲突 (CS0433) -->
		<Reference Include="../../lib/*.dll" Exclude="../../lib/0Harmony20.dll">
			<Private>false</Private>
		</Reference>

		<!-- 2. BepInEx 核心 -->
		<!-- 排除 0Harmony20.dll：其全局命名空间的 HarmonyLib 类型与 0Harmony.dll 冲突 (CS0433)，由 lib 下的别名引用提供 -->
		<Reference Include="$(RainWorldDir)/BepInEx/core/*.dll" Exclude="$(RainWorldDir)/BepInEx/core/0Harmony20.dll">
		<Private>false</Private>
		</Reference>

		<Reference Include="$(RainWorldDir)/BepInEx/core/0Harmony20.dll" Version="2.0.0" Aliases="Harmony20">
			<Private>false</Private>
		</Reference>


		<!-- 3. BepInEx 插件（其他模组） -->
		<Reference Include="$(RainWorldDir)/BepInEx/plugins/*.dll">
		<Private>false</Private>
		</Reference>

		<!-- 4. BepInEx 工具库 -->
		<Reference Include="$(RainWorldDir)/BepInEx/utils/*.dll">
		<Private>false</Private>
		</Reference>

		<!-- 5. Unity 引擎 -->
		<Reference Include="$(RainWorldDir)/RainWorld_Data/Managed/Unity*.dll">
		<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="PolySharp" Version="1.15.0">
		<PrivateAssets>all</PrivateAssets>
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Debug\**" />
	  <EmbeddedResource Remove="Debug\**" />
	  <None Remove="Debug\**" />
	  <Reference Remove="Debug\**" />
	</ItemGroup>

	<Target Name="GenerateMod" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<RemovePlugins Include="../mod/newest/plugins/*.*" />
			<RemovePlugins Include="../mod/plugins/*.*" />
		</ItemGroup>
		<ItemGroup>
			<CopyPlugins Include="$(TargetPath)" />
			<!-- 只在 Debug 时复制 PDB -->
			<CopyPlugins Condition="'$(Configuration)' == 'Debug'"
						 Include="$(TargetDir)$(TargetName).pdb" />
		</ItemGroup>
		
		<Delete Files="@(RemovePlugins)" />
		
		<!-- 复制到 newest -->
		<Copy SourceFiles="@(CopyPlugins)" DestinationFolder="../mod/newest/plugins/" />
		<!-- Release 时额外清理 PDB -->
		<Delete Condition="'$(Configuration)' == 'Release'"
				Files="../mod/newest/plugins/*.pdb" />

		<!-- 复制到 plugins -->
		<Copy SourceFiles="@(CopyPlugins)" DestinationFolder="../mod/plugins/" />
		<!-- Release 时额外清理 PDB -->
		<Delete Condition="'$(Configuration)' == 'Release'"
				Files="../mod/plugins/*.pdb" />
	</Target>
	
</Project>
